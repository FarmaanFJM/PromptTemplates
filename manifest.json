{
  "manifest_version": 3,
  "name": "PromptTemplates",
  "version": "1.0.0",
  "description": "Create and reuse prompt templates with dynamic placeholders.",
  "action": {
    "default_title": "PromptTemplates",
    "default_popup": "src/popup/popup.html"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/content_script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "src/assets/icons/icon16.png",
    "32": "src/assets/icons/icon32.png",
    "48": "src/assets/icons/icon48.png",
    "128": "src/assets/icons/icon128.png"
  }
}